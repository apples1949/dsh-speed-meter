{
  "name": "@apples1949/dsh-speed-meter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apples1949/dsh-speed-meter.git"
  },
  "homepage": "https://github.com/apples1949/dsh-speed-meter#readme",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "meta": {
    "title": "实时输出速度",
